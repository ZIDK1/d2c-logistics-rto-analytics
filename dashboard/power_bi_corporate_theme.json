{
  "name": "D2C Logistics Corporate Light Theme",
  "dataColors": [
    "#2563EB",
    "#DC2626",
    "#059669",
    "#D97706",
    "#475569",
    "#0284C7",
    "#7C3AED",
    "#EA580C"
  ],
  "background": "#F4F6F9",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#059669",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#475569"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F6F9" } },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#475569" } },
            "backColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#0F172A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#0F172A" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
